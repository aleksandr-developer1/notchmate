    "Репозиторий определяется по активному терминалу (вкладка, в которой вы печатали последней), редактору или агенту — без дополнительных разрешений.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository wird am aktiven Terminal (dem Tab, in dem du zuletzt getippt hast), Editor oder Agenten erkannt – ohne zusätzliche Berechtigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repository is detected from the active terminal (the tab you typed in last), editor or agent — no extra permissions needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio se detecta por la terminal activa (la pestaña donde escribiste por última vez), el editor o el agente, sin permisos adicionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt est détecté via le terminal actif (l’onglet où vous avez tapé en dernier), l’éditeur ou l’agent — sans autorisation supplémentaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリはアクティブなターミナル（最後に入力したタブ）、エディタ、エージェントから判別します。追加の許可は不要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repositório é detectado pelo terminal ativo (a aba em que você digitou por último), editor ou agente — sem permissões extras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据当前终端（你最后输入的标签页）、编辑器或代理识别仓库——无需额外权限。"
          }
        }
      }
    },
