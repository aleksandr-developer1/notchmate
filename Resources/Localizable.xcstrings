    "Показывать ближайшую встречу в вырезе, напоминать о ней и понимать, что идёт созвон.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nächsten Termin in der Notch zeigen, daran erinnern und erkennen, wann ein Anruf läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
