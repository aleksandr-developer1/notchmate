    "Расшифровка идёт на этом компьютере. В ИИ уходят последние несколько минут разговора и короткие выдержки из кода выбранного репозитория.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription läuft auf diesem Computer. An die KI gehen die letzten Minuten des Gesprächs und kurze Code-Auszüge aus dem gewählten Repository."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription runs on this computer. The AI receives the last few minutes of the conversation and short excerpts from the selected repository's code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción se hace en este ordenador. A la IA van los últimos minutos de la conversación y breves fragmentos del código del repositorio elegido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription se fait sur cet ordinateur. L’IA reçoit les dernières minutes de la conversation et de courts extraits du code du dépôt choisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしはこのコンピュータで行います。AI に送られるのは会話の直近数分と、選択したリポジトリのコードの短い抜粋です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição acontece neste computador. A IA recebe os últimos minutos da conversa e trechos curtos do código do repositório escolhido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写在这台电脑上进行。发送给 AI 的只有最近几分钟的对话和所选仓库的少量代码片段。"
          }
        }
      }
    },
