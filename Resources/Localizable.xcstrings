    "NotchMate сам поймёт, в каком репозитории вы работаете: ветка, изменения, CI и коммит в пару кликов": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate erkennt selbst, in welchem Repository du arbeitest: Branch, Änderungen, CI und ein Commit mit wenigen Klicks"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate figures out which repository you're working in: branch, changes, CI and a commit in a couple of clicks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate detecta en qué repositorio trabajas: rama, cambios, CI y commit en un par de clics"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate détecte seul le dépôt sur lequel vous travaillez : branche, modifications, CI et commit en deux clics"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate は作業中のリポジトリを自動で判別します：ブランチ、変更、CI、数クリックでコミット"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NotchMate descobre em qual repositório você está: branch, alterações, CI e commit em poucos cliques"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate 会自动识别你正在使用的仓库：分支、更改、CI，点几下就能提交"
