    "Пароли из менеджеров паролей (помеченные как скрытые) не сохраняются. История хранится только в памяти.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwörter aus Passwortmanagern (als verborgen markiert) werden nicht gespeichert. Der Verlauf liegt nur im Arbeitsspeicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords from password managers (marked as concealed) aren't saved. History is kept in memory only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guardan las contraseñas de los gestores de contraseñas (marcadas como ocultas). El historial solo se guarda en memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de passe des gestionnaires (marqués comme masqués) ne sont pas enregistrés. L’historique reste uniquement en mémoire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードマネージャーのパスワード（非表示として指定されたもの）は保存しません。履歴はメモリ上にのみ保持されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Senhas de gerenciadores de senhas (marcadas como ocultas) não são salvas. O histórico fica só na memória."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自密码管理器（标记为隐藏）的密码不会被保存。历史只保存在内存中。"
          }
        }
      }
    },
