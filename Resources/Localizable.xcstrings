            "state": "translated",
            "value": "在通话中录下你的声音，并知道正在进行对话。"
          }
        }
      }
    },
    "Записать голоса собеседников — звук Zoom, Телемоста или браузера. Экран не снимается и никуда не отправляется.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die anderen Teilnehmer aufnehmen – Ton von Zoom, Telemost oder dem Browser. Der Bildschirm wird weder aufgenommen noch gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record the other participants — sound from Zoom, Telemost or the browser. The screen isn't captured or sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar a los demás participantes: el sonido de Zoom, Telemost o el navegador. La pantalla no se graba ni se envía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer les autres participants — le son de Zoom, Telemost ou du navigateur. L’écran n’est ni capturé ni envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の声を録音します（Zoom、Telemost、ブラウザの音声）。画面は録画も送信もしません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravar os outros participantes — o som do Zoom, Telemost ou navegador. A tela não é capturada nem enviada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制其他参与者——来自 Zoom、Telemost 或浏览器的声音。不会录屏，也不会发送到任何地方。"
          }
        }
      }
    },
