    "Переведи на английский (если текст на английском — на русский):\n\n%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetze ins Deutsche (wenn der Text schon deutsch ist – ins Englische):\n\n%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate into English (if the text is already in English — into Russian):\n\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce al español (si el texto ya está en español, al inglés):\n\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduis en français (si le texte est déjà en français — en anglais) :\n\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日本語に翻訳して（すでに日本語なら英語に）：\n\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduza para o português (se o texto já estiver em português — para o inglês):\n\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译成中文（如果已经是中文，则翻译成英文）：\n\n%@"
          }
        }
      }
    },
