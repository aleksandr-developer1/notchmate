          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Obsidian 中打开一个仓库，或在设置中选择文件夹"
          }
        }
      }
    },
    "Открывает «Заметки» с полем ввода: пишите и нажмите ↩.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Notizen mit einem Eingabefeld: tippen und ↩ drücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Notes with an input field: type and press ↩."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Notas con un campo de texto: escribe y pulsa ↩."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Notes avec un champ de saisie : tapez puis appuyez sur ↩."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄付きでメモを開きます：入力して ↩ を押します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Notas com um campo de texto: digite e pressione ↩."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开带输入框的“笔记”：输入后按 ↩。"
          }
        }
      }
    },
    "Открывает задачу Jira, заметку, файл на полке или изменённый файл в Git.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet eine Jira-Aufgabe, eine Notiz, eine Datei in der Ablage oder eine geänderte Datei in Git."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a Jira issue, a note, a file on the shelf or a changed file in Git."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una tarea de Jira, una nota, un archivo de la estantería o un archivo modificado en Git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une tâche Jira, une note, un fichier de l’étagère ou un fichier modifié dans Git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jira の課題、メモ、シェルフのファイル、Git の変更ファイルを開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre uma tarefa do Jira, uma nota, um arquivo da estante ou um arquivo alterado no Git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Jira 任务、笔记、文件架上的文件或 Git 中已更改的文件。"
          }
        }
      }
    },
    "Открывает на последней вкладке, повторное нажатие закрывает.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den letzten Tab; erneut drücken schließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens on the last tab; press again to close."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre en la última pestaña; púlsalo otra vez para cerrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre sur le dernier onglet ; appuyez à nouveau pour fermer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のタブで開きます。もう一度押すと閉じます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre na última aba; pressione de novo para fechar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开到上次的标签页，再按一次关闭。"
          }
        }
      }
    },
