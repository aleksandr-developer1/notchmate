    "Период «Сегодня», интервал агрегации — минуты или час, запуск каждый час.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitraum „Heute“, Aggregationsintervall – Minuten oder Stunde, stündlich ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Period “Today”, aggregation interval — minutes or hour, run every hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Periodo «Hoy», intervalo de agregación: minutos u hora, ejecutar cada hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Période « Aujourd’hui », intervalle d’agrégation — minutes ou heure, exécution toutes les heures."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間「今日」、集計間隔は分または時間、毎時実行。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Período “Hoje”, intervalo de agregação — minutos ou hora, executar a cada hora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时段“今天”，聚合间隔为分钟或小时，每小时运行一次。"
          }
        }
      }
    },
    "Пик напряжения обычно в %lld:00 (%lld против %lld)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anspannung ist meist um %lld:00 am höchsten (%lld gegenüber %lld)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tension usually peaks at %lld:00 (%lld vs %lld)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tensión suele llegar al máximo a las %lld:00 (%lld frente a %lld)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tension culmine généralement à %lld:00 (%lld contre %lld)"
          }
        },
        "ja": {
