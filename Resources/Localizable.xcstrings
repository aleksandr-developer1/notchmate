{
  "sourceLanguage": "ru",
  "strings": {
    "": {},
    "\n\n_Модель отказалась отвечать на этот запрос._": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_Das Modell hat die Antwort auf diese Anfrage verweigert._"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_The model declined to answer this request._"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_El modelo se negó a responder a esta solicitud._"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_Le modèle a refusé de répondre à cette demande._"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_モデルがこのリクエストへの回答を拒否しました。_"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_O modelo se recusou a responder a este pedido._"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_模型拒绝回答此请求。_"
          }
        }
      }
    },
    "\n\n_Слишком много шагов с инструментами — остановился._": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_Zu viele Werkzeugschritte – angehalten._"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_Too many tool steps — stopped._"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_Demasiados pasos con herramientas: me detuve._"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_Trop d’étapes avec des outils — arrêt._"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_ツールのステップが多すぎるため停止しました。_"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_Muitas etapas com ferramentas — parei._"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n_工具步骤过多，已停止。_"
          }
        }
      }
    },
