    },
    "NotchMate не просит доступ к файлам и не отправляет ничего наружу: запись созвонов, расшифровка и адреса вкладок остаются на этом компьютере.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate fragt nicht nach Dateizugriff und sendet nichts nach außen: Anrufaufnahmen, Transkripte und Tab-Adressen bleiben auf diesem Computer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate doesn't ask for file access and sends nothing out: call recordings, transcripts and tab addresses stay on this computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate no pide acceso a archivos ni envía nada fuera: las grabaciones de llamadas, transcripciones y direcciones de pestañas se quedan en este ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate ne demande pas l’accès aux fichiers et n’envoie rien à l’extérieur : enregistrements d’appels, transcriptions et adresses des onglets restent sur cet ordinateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate はファイルへのアクセスを求めず、外部に何も送信しません。通話の録音、文字起こし、タブのアドレスはこのコンピュータに残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NotchMate não pede acesso a arquivos nem envia nada para fora: gravações de chamadas, transcrições e endereços das abas ficam neste computador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate 不请求文件访问，也不向外发送任何内容：通话录音、转写和标签页地址都保留在这台电脑上。"
          }
        }
      }
    },
    "NotchMate нужен доступ к приложению «Заметки»": {
      "localizations": {
