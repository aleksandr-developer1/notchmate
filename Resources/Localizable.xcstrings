    "Не удалось расшифровать: для «%@» нет распознавания на устройстве. Включите язык в Системных настройках → Клавиатура → Диктовка, или поставьте модель whisper.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkription fehlgeschlagen: Für „%@“ gibt es keine Erkennung auf dem Gerät. Aktiviere die Sprache unter Systemeinstellungen → Tastatur → Diktat oder installiere ein whisper-Modell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't transcribe: there's no on-device recognition for “%@”. Turn the language on in System Settings → Keyboard → Dictation, or install a whisper model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo transcribir: no hay reconocimiento en el dispositivo para «%@». Activa el idioma en Ajustes del Sistema → Teclado → Dictado o instala un modelo whisper."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription impossible : pas de reconnaissance sur l’appareil pour « %@ ». Activez la langue dans Réglages Système → Clavier → Dictée, ou installez un modèle whisper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしできませんでした：「%@」にはデバイス上の認識がありません。システム設定 → キーボード → 音声入力 で言語をオンにするか、whisper モデルを入れてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível transcrever: não há reconhecimento no dispositivo para “%@”. Ative o idioma em Ajustes do Sistema → Teclado → Ditado ou instale um modelo whisper."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法转写：“%@”不支持设备端识别。请在“系统设置 → 键盘 → 听写”中开启该语言，或安装 whisper 模型。"
          }
        }
      }
    },
