    "Через 8 секунд на отвлекающем приложении или сайте Taby расстраивается и зовёт обратно. Для проверки сайтов macOS один раз спросит разрешение управлять браузером.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach 8 Sekunden in einer ablenkenden App oder Website wird Taby traurig und ruft dich zurück. Zum Prüfen von Websites fragt macOS einmal nach der Erlaubnis, den Browser zu steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After 8 seconds in a distracting app or site, Taby gets upset and calls you back. To check sites, macOS will ask once for permission to control the browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras 8 segundos en una app o web que distrae, Taby se entristece y te llama de vuelta. Para comprobar webs, macOS pedirá una vez permiso para controlar el navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après 8 secondes sur une app ou un site distrayant, Taby se fâche et vous rappelle. Pour vérifier les sites, macOS demandera une fois l’autorisation de contrôler le navigateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気が散るアプリやサイトに 8 秒いると、Taby がしょんぼりして呼び戻します。サイトの確認のため、macOS がブラウザ操作の許可を一度だけ求めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de 8 segundos num app ou site que distrai, Taby fica chateado e chama você de volta. Para verificar sites, o macOS vai pedir uma vez permissão para controlar o navegador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在让人分心的应用或网站停留 8 秒后，Taby 会不高兴并叫你回来。为检查网站，macOS 会询问一次是否允许控制浏览器。"
          }
        }
      }
    },
    "Через пару дней с часами и NotchMate здесь появятся закономерности": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach ein paar Tagen mit Uhr und NotchMate erscheinen hier Muster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a couple of days with the watch and NotchMate, patterns will appear here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras un par de días con el reloj y NotchMate, aquí aparecerán patrones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après quelques jours avec la montre et NotchMate, des tendances apparaîtront ici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計と NotchMate を数日使うと、ここに傾向が表示されます"
          }
        },
        "pt-BR": {
          "stringUnit": {
