    "API-ключи хранятся локально в файле настроек NotchMate с закрытыми правами доступа. Связка ключей macOS не используется.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel werden lokal in der Einstellungsdatei von NotchMate mit eingeschränkten Rechten gespeichert. Der macOS-Schlüsselbund wird nicht verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API keys are stored locally in NotchMate's settings file with restricted permissions. The macOS Keychain isn't used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de API se guardan localmente en el archivo de ajustes de NotchMate con permisos restringidos. No se usa el Llavero de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API sont stockées localement dans le fichier de réglages de NotchMate, avec des droits restreints. Le trousseau macOS n’est pas utilisé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーは NotchMate の設定ファイルにアクセス制限付きでローカル保存されます。macOS のキーチェーンは使用しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves de API ficam salvas localmente no arquivo de ajustes do NotchMate com permissões restritas. As Chaves do macOS não são usadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥以受限权限保存在 NotchMate 的本地设置文件中，不使用 macOS 钥匙串。"
          }
        }
      }
    },
