          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins d’une minute — rien à imputer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分未満 — 記録するものはありません"
          }
        },
        "pt-BR": {
          "stringUnit": {
