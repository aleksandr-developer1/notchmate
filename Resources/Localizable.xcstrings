        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "403 — アクセス不可（CAPTCHA が必要かもしれません：ブラウザで Jira にログインしてください）"
          }
        },
        "pt-BR": {
          "stringUnit": {
