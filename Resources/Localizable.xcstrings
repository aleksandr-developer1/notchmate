    "Первое нажатие включает подсказки и запись разговора, повторное — подсказать прямо сейчас.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstes Drücken schaltet Hinweise und Gesprächsaufnahme ein, erneutes Drücken gibt sofort einen Hinweis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first press turns on hints and recording of the conversation; the second gives a hint right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera pulsación activa las sugerencias y la grabación de la conversación; la segunda da una sugerencia al momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier appui active les indices et l’enregistrement de la conversation ; le second donne un indice tout de suite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回目でヒントと会話の録音をオン、2 回目で今すぐヒントを出します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro toque ativa as dicas e a gravação da conversa; o segundo dá uma dica na hora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次按下开启提示并录制对话，再按一次立即给出提示。"
          }
        }
      }
    },
