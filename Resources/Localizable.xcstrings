    "Записать ваш голос на созвоне и понять, что разговор вообще идёт.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme im Anruf aufnehmen und erkennen, dass gerade gesprochen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your voice on calls and notice that a conversation is going on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar tu voz en las llamadas y saber que hay una conversación en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer votre voix pendant les appels et savoir qu’une conversation a lieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話であなたの声を録音し、会話中であることを把握します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
