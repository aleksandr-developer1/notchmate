    "macOS уже спрашивал и больше не спросит. Откройте список и включите «%@».": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat schon gefragt und fragt nicht erneut. Öffne die Liste und aktiviere „%@“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS already asked and won't ask again. Open the list and turn on “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ya lo preguntó y no volverá a hacerlo. Abre la lista y activa «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a déjà demandé et ne redemandera pas. Ouvrez la liste et activez « %@ »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS はすでに確認済みで、再度は尋ねません。一覧を開いて「%@」をオンにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS já perguntou e não vai perguntar de novo. Abra a lista e ative “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已经询问过，不会再问。打开列表并开启“%@”。"
          }
        }
      }
    },
