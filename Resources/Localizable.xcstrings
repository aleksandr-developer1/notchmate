    " Время свободно.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Die Zeit ist frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Your time is free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Tienes el tiempo libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Ton temps est libre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 時間は空いています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Seu tempo está livre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 这段时间是空闲的。"
          }
        }
      }
    },
    " Успеешь разобрать дела ниже.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Du schaffst noch die Aufgaben unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " You have time to sort out the tasks below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Te da tiempo a revisar las tareas de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Tu as le temps de traiter les tâches ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 下のタスクを片付ける時間があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Dá tempo de resolver as tarefas abaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 来得及处理下面的事项。"
          }
        }
      }
    },
