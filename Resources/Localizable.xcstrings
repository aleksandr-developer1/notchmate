    "Для «%@» нет офлайн-модели — скачайте язык в Системных настройках → Клавиатура → Диктовка": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für „%@“ gibt es kein Offline-Modell – lade die Sprache unter Systemeinstellungen → Tastatur → Diktat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no offline model for “%@” — download the language in System Settings → Keyboard → Dictation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay modelo sin conexión para «%@»: descarga el idioma en Ajustes del Sistema → Teclado → Dictado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de modèle hors ligne pour « %@ » — téléchargez la langue dans Réglages Système → Clavier → Dictée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のオフラインモデルがありません — システム設定 → キーボード → 音声入力 で言語をダウンロードしてください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há modelo offline para “%@” — baixe o idioma em Ajustes do Sistema → Teclado → Ditado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”没有离线模型——请在“系统设置 → 键盘 → 听写”中下载该语言"
          }
        }
      }
    },
    "Для «%@» нет офлайн-распознавания — скачайте язык в Системных настройках → Клавиатура → Диктовка": {
      "localizations": {
        "de": {
          "stringUnit": {
