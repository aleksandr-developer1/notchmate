            "state": "translated",
            "value": "Abre una bóveda en Obsidian o elige una carpeta en los ajustes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un coffre dans Obsidian ou choisissez un dossier dans les réglages"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian で保管庫を開くか、設定でフォルダを選んでください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
