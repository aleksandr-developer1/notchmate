    "Помоги спланировать рабочий день: предложи структуру с блоками фокуса и перерывами.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf mir, meinen Arbeitstag zu planen: schlage eine Struktur mit Fokusblöcken und Pausen vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help me plan my workday: suggest a structure with focus blocks and breaks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayúdame a planificar la jornada: propón una estructura con bloques de foco y descansos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide-moi à planifier ma journée : propose une structure avec des blocs de focus et des pauses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日の作業計画を手伝って：集中ブロックと休憩を含む構成を提案して。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Me ajude a planejar o dia de trabalho: sugira uma estrutura com blocos de foco e pausas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮我规划工作日：给出包含专注时段和休息的安排。"
          }
        }
      }
    },
    "Помоги сформулировать задачу для Jira: заголовок, описание, критерии приёмки. Сначала задай мне 2–3 уточняющих вопроса.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf mir, eine Jira-Aufgabe zu formulieren: Titel, Beschreibung, Akzeptanzkriterien. Stell mir zuerst 2–3 Rückfragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help me write a Jira issue: title, description, acceptance criteria. First ask me 2–3 clarifying questions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayúdame a redactar una tarea de Jira: título, descripción, criterios de aceptación. Primero hazme 2–3 preguntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide-moi à rédiger une tâche Jira : titre, description, critères d’acceptation. Pose-moi d’abord 2–3 questions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jira の課題を書くのを手伝って：タイトル、説明、受け入れ基準。まず確認の質問を 2〜3 個して。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Me ajude a escrever uma tarefa do Jira: título, descrição, critérios de aceitação. Primeiro me faça 2–3 perguntas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮我写一个 Jira 任务：标题、描述、验收标准。先问我 2–3 个澄清问题。"
          }
        }
      }
    },
