    "403 — нет доступа (возможно, нужна капча: войдите в Jira в браузере)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "403 – kein Zugriff (evtl. Captcha nötig: melde dich im Browser bei Jira an)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "403 — no access (a captcha may be needed: sign in to Jira in the browser)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "403: sin acceso (puede requerir captcha: inicia sesión en Jira en el navegador)"
