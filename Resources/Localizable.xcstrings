    },
    "Метрики: пульс, пульс покоя, вариабельность пульса, шаги, анализ сна, частота дыхания, кислород в крови.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metriken: Puls, Ruhepuls, Herzfrequenzvariabilität, Schritte, Schlafanalyse, Atemfrequenz, Blutsauerstoff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metrics: heart rate, resting heart rate, heart rate variability, steps, sleep analysis, respiratory rate, blood oxygen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Métricas: pulso, pulso en reposo, variabilidad de la frecuencia cardiaca, pasos, análisis del sueño, frecuencia respiratoria, oxígeno en sangre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métriques : pouls, pouls au repos, variabilité de la fréquence cardiaque, pas, analyse du sommeil, fréquence respiratoire, oxygène sanguin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指標：心拍数、安静時心拍数、心拍変動、歩数、睡眠分析、呼吸数、血中酸素。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Métricas: pulso, pulso em repouso, variabilidade da frequência cardíaca, passos, análise do sono, frequência respiratória, oxigênio no sangue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指标：心率、静息心率、心率变异性、步数、睡眠分析、呼吸频率、血氧。"
          }
        }
      }
    },
