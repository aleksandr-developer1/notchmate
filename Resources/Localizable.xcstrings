    "Сегодня больше ничего не запланировано. Спроси меня о дне.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist nichts mehr geplant. Frag mich nach deinem Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing else is planned for today. Ask me about your day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada más previsto para hoy. Pregúntame por tu día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’autre de prévu aujourd’hui. Demande-moi comment se présente ta journée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はもう予定がありません。一日のことを聞いてね。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há mais nada planejado para hoje. Pergunte-me sobre o seu dia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天没有别的安排了。问问我今天的情况吧。"
          }
        }
      }
    },
