    "Меньше минуты — нечего списывать": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger als eine Minute – nichts zu buchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than a minute — nothing to log"
          }
        },
        "es": {
          "stringUnit": {
