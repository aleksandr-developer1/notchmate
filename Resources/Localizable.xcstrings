          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit messages are written by the AI chosen in the settings: it receives the diff of the changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes de commit los escribe la IA elegida en los ajustes: recibe el diff de los cambios."
          }
        },
        "fr": {
