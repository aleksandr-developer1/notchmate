          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tensão costuma atingir o pico às %lld:00 (%lld contra %lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧张通常在 %lld:00 达到高峰（%lld 对比 %lld）"
          }
        }
      }
    },
