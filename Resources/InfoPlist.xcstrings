    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufe werden auf diesem Computer transkribiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls are transcribed on this computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas se transcriben en este ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels sont transcrits sur cet ordinateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話はこのコンピュータ上で文字起こしされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas são transcritas neste computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка созвона выполняется на этом компьютере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话在这台电脑上转写。"
          }
        }
      }
    }
  },
