    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate verbindet sich mit deinem KI-Server im lokalen Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate connects to your AI server on the local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate se conecta a tu servidor de IA en la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate se connecte à votre serveur d’IA sur le réseau local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate はローカルネットワーク上の AI サーバーに接続します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NotchMate se conecta ao seu servidor de IA na rede local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate подключается к вашему ИИ-серверу в локальной сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate 会连接到局域网中的你的 AI 服务器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate nimmt Anrufe auf, um auf diesem Computer Transkript und Protokoll zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate records calls to make a transcript and minutes on this computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate graba las llamadas para hacer la transcripción y el acta en este ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate enregistre les appels pour en faire la transcription et le compte rendu sur cet ordinateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate は通話を録音し、このコンピュータ上で文字起こしと議事録を作成します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NotchMate grava chamadas para fazer a transcrição e a ata neste computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate записывает созвон, чтобы сделать расшифровку и протокол на этом компьютере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate 录制通话，以便在这台电脑上生成转写和纪要。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate zeigt die heutigen Erinnerungen auf der Tagesleiste und hakt sie ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate shows today's reminders on the day timeline and marks them done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate muestra los recordatorios de hoy en la línea del día y los marca como hechos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate affiche les rappels du jour sur la frise et les coche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate は今日のリマインダーをタイムラインに表示し、完了にします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NotchMate mostra os lembretes de hoje na linha do dia e os marca como concluídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помощник показывает напоминания на сегодня на шкале дня и отмечает их выполненными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate 会在日程时间线上显示今天的提醒并标记完成。"
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
