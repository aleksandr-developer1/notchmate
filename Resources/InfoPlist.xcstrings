{
  "sourceLanguage": "ru",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate zeigt und speichert deine Notizen aus „Notizen“ und prüft die offene Website im Browser, um Ablenkungen im Fokus zu erkennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate shows and saves your notes from Notes and checks the open website in the browser to notice distractions during focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate muestra y guarda tus notas de Notas y comprueba la web abierta en el navegador para detectar distracciones durante el foco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate affiche et enregistre vos notes de Notes et vérifie le site ouvert dans le navigateur pour repérer les distractions pendant le focus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate は「メモ」のメモを表示・保存し、集中中の気晴らしに気づくためにブラウザで開いているサイトを確認します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NotchMate mostra e salva suas notas do Notas e verifica o site aberto no navegador para perceber distrações durante o foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate показывает и записывает ваши заметки из «Заметок» и проверяет открытый сайт в браузере, чтобы замечать отвлечения во время фокуса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate 会显示并保存你在“备忘录”中的笔记，并检查浏览器中打开的网站，以便在专注时发现分心。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate zeigt deine nächsten Termine in der Notch und erinnert dich daran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate shows your upcoming meetings in the notch and reminds you about them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate muestra tus próximas reuniones en el notch y te las recuerda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate affiche vos prochaines réunions dans l’encoche et vous les rappelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate は次の会議をノッチに表示し、お知らせします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NotchMate mostra suas próximas reuniões no notch e lembra você delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate показывает ближайшие встречи в вырезе и напоминает о них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMate 会在刘海中显示即将到来的会议并提醒你。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
